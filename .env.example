# ============================================================
# Audial - 环境变量配置
# 复制此文件为 .env 并填入你对应的值
# （.env 已加入 .gitignore，不会被提交到 Git）
# ============================================================

# ---- 数据库 ----
# PostgreSQL 连接字符串 (例如: postgresql://user:password@host:5432/dbname)
DATABASE_URL=

# ---- AI 服务 ----
# OpenAI API Key (用于 TTS 语音合成、STT 语音识别)
# 申请地址: https://platform.openai.com
OPENAI_API_KEY=

# DeepSeek API Key (用于文本生成、翻译、发音/听写/背诵评分)
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DeepSeek 模型名: deepseek-v4-pro (默认) 或 deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek Base URL (默认 https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Clerk 认证 ----
# Clerk Secret Key (用于服务端 JWT 验证)
CLERK_SECRET_KEY=
# Clerk Publishable Key (用于客户端)
CLERK_PUBLISHABLE_KEY=

# ---- 部署 ----
# 部署域名 (用于 Expo 构建，例如: audial.example.com)
EXPO_PUBLIC_DOMAIN=

# ---- 基础配置 ----
# 服务器端口 (默认 8080)
# PORT=8080
# 环境模式: development | production
NODE_ENV=development
